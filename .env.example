# Postgres connection string (Railway provides this automatically when you
# add a Postgres plugin to your project).
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Single-user login credentials.
# AUTH_PASSWORD_HASH is a bcrypt hash of your chosen password -- see README.md
# for how to generate it. Never put the plain-text password here.
# NOTE: bcrypt hashes contain "$" characters. In a local .env file, Next.js's
# env loader treats "$name" as a variable reference, so escape every "$" as
# "\$" here (e.g. "\$2b\$12\$..."). This escaping is NOT needed for variables
# set directly on Railway's dashboard.
AUTH_USERNAME="thoufeeq"
AUTH_PASSWORD_HASH=""

# Any long random string, used to sign session cookies.
AUTH_SECRET=""

# Cloudflare R2 (S3-compatible object storage) credentials.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="thouftube"
